{% comment %}
EE • Grid (Custom)
- 3×2 square tiles
- Choose product per block
- Optional image override per block so you can drop the exact comp images
- Hotspot button prepared (for a later JS quick view if needed)
{% endcomment %}

<section class="ee-grid page-width" id="ee-grid-{{ section.id }}">
  {% if section.settings.heading != blank %}
    <h2 class="ee-grid__heading">{{ section.settings.heading }}</h2>
  {% endif %}

  <div class="ee-grid__wrap">
    {% for block in section.blocks %}
      {% assign product = block.settings.product %}
      {% assign override = block.settings.override_image %}

      {% if product or override %}
        <article class="ee-card" {{ block.shopify_attributes }}>
          <a
            class="ee-card__img"
            {% if product %} href="{{ product.url }}" {% else %} href="#" {% endif %}
          >
            {% if override != blank %}
              {% assign img = override %}
              <img
                src="{{ img | image_url: width: 800, height: 800, crop: 'center' }}"
                width="800"
                height="800"
                alt="{{ img.alt | escape | default: product.title }}"
                loading="lazy"
              >
            {% elsif product and product.featured_image %}
              {% assign img = product.featured_image %}
              <img
                src="{{ img | image_url: width: 800, height: 800, crop: 'center' }}"
                width="800"
                height="800"
                alt="{{ img.alt | escape }}"
                loading="lazy"
              >
            {% else %}
              {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
            {% endif %}
          </a>

          <h3 class="ee-card__title">
            {% if product %}{{ product.title }}{% endif %}
          </h3>

          <button class="ee-hotspot" type="button" aria-label="Show quick view" data-ee-quickview></button>
        </article>
      {% endif %}
    {% endfor %}
  </div>

  <dialog class="ee-modal" data-ee-modal hidden>
    <form method="dialog" class="ee-modal__close" aria-label="Close">✕</form>
    <div class="ee-modal__content" data-ee-modal-content></div>
  </dialog>
</section>

{% schema %}
{
  "name": "EE • Grid (Custom)",
  "class": "ee-grid-section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Tisso vison in the wild" }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Tile",
      "limit": 6,
      "settings": [
        { "type": "product", "id": "product", "label": "Select product (optional if you only want an image)" },
        { "type": "image_picker", "id": "override_image", "label": "Override image (800×800+ recommended)" }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [{ "name": "EE • Grid (Custom)" }]
}
{% endschema %}
