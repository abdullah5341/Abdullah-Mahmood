{% comment %}
EE • Grid (Custom Images)
- 6 image slots configured from the Theme Editor
- Renders a 3×2 grid with square-ish tiles (object-fit: cover)
{% endcomment %}

<section class="ee-grid page-width" id="ee-grid-{{ section.id }}">
  {% if section.settings.heading != blank %}
    <h2 class="ee-grid__heading">{{ section.settings.heading }}</h2>
  {% endif %}

  <div class="ee-grid__wrap" role="list">
    {% for block in section.blocks %}
      {% assign img = block.settings.image %}
      <article class="ee-card" role="listitem" {{ block.shopify_attributes }}>
        {% if img != blank %}
          <img
            src="{{ img | image_url: width: 900, height: 900, crop: 'center' }}"
            width="900"
            height="900"
            alt="{{ block.settings.alt | escape }}"
            loading="lazy"
          >
        {% else %}
          <div class="ee-card__placeholder">Add image</div>
        {% endif %}
      </article>
    {% endfor %}
  </div>

  {% schema %}
{
  "name": "EE • Grid (Custom)",
  "class": "ee-grid-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Tisso vison in the wild"
    }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Product",
      "settings": [
        { "type": "product", "id": "product", "label": "Select product" }
      ]
    },
    {
      "type": "image",
      "name": "Image",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Upload image" },
        { "type": "text", "id": "alt", "label": "Alt text" },
        { "type": "text", "id": "caption", "label": "Caption (optional)" }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [{ "name": "EE • Grid (Custom)" }]
}
{% endschema %}

</section>
