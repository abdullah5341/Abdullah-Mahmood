{% comment %}
EE • Grid (Custom)
- Six product cards picked from the customizer
- Square thumbnails, responsive grid
- Hotspot button opens modal (wired in Milestone 4)
{% endcomment %}

<section class="ee-grid page-width" id="ee-grid-{{ section.id }}">
  {% if section.settings.heading != blank %}
    <h2 class="ee-grid__heading">{{ section.settings.heading }}</h2>
  {% endif %}

  <div class="ee-grid__wrap">
    {% for block in section.blocks %}
      {% assign product = block.settings.product %}
      {% if product %}
        <article
          class="ee-card"
          data-product-handle="{{ product.handle }}"
          {{ block.shopify_attributes }}
        >
          <a class="ee-card__img" href="{{ product.url }}">
            {%- if product.featured_image -%}
              {%- assign img = product.featured_image -%}
              <img
                src="{{ img | image_url: width: 800, height: 800, crop: 'center' }}"
                width="800"
                height="800"
                alt="{{ img.alt | escape }}"
                loading="lazy"
              >
            {%- endif -%}
          </a>

          <h3 class="ee-card__title">{{ product.title }}</h3>

          <!-- Hotspot (we’ll hook JS to this in Milestone 4) -->
          <button
            class="ee-hotspot"
            type="button"
            aria-label="Show product quick view"
            data-ee-quickview
          >
            ●
          </button>
        </article>
      {% endif %}
    {% endfor %}
  </div>

  {%- comment -%}
    One dialog container per section; populated by JS later (Milestone 4).
  {%- endcomment -%}
  <dialog class="ee-modal" data-ee-modal hidden>
    <form method="dialog" class="ee-modal__close" aria-label="Close">✕</form>
    <div class="ee-modal__content" data-ee-modal-content></div>
  </dialog>

  {% schema %}
  {
    "name": "EE • Grid (Custom)",
    "class": "ee-grid-section",
    "settings": [
      {
        "type": "text",
        "id": "heading",
        "label": "Heading",
        "default": "Tisso vison in the wild"
      }
    ],
    "blocks": [
      {
        "type": "product",
        "name": "Product",
        "limit": 6,
        "settings": [
          { "type": "product", "id": "product", "label": "Select product" }
        ]
      }
    ],
    "max_blocks": 6,
    "presets": [{ "name": "EE • Grid (Custom)" }]
  }
  {% endschema %}
</section>
