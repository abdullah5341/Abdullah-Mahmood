{% comment %}
  EE • Grid (Custom)
  Six image cards with a + hotspot that opens a product modal (no jQuery).
  - Each block chooses 1 product.
  - Bonus product (auto-add) is optional in the section settings.
  - The modal is a single DOM node that’s populated from per-block JSON the section renders.
{% endcomment %}

<section class="ee-grid" id="ee-grid-{{ section.id }}">
  {% style %}
    /* Inject asset URLs for icons */
    #ee-grid-{{ section.id }}{
      --ee-plus: url({{ 'plus.svg' | asset_url }});
    }
  {% endstyle %}

  {% if section.settings.heading != blank %}
    <h2 class="ee-grid__heading">{{ section.settings.heading | escape }}</h2>
  {% endif %}

  <div class="ee-grid__wrap">
    {% for block in section.blocks %}
      {% assign product = block.settings.product %}
      {% if product %}
        {%- assign featured = product.featured_image | default: product.images.first -%}
        <!-- IMPORTANT: include block.shopify_attributes for Theme Editor -->
        <article
          class="ee-card"
          data-block-id="{{ block.id }}"
          {{ block.shopify_attributes }}
        >
          <!-- Make the image open the quick view too -->
          <a
            href="{{ product.url }}"
            class="ee-card__img"
            aria-label="{{ product.title | escape }}"
            data-open-quick
            data-block-id="{{ block.id }}"
          >
            {{ featured | image_url: width: 1000 | image_tag: alt: product.title, loading: 'lazy' }}
          </a>

          <!-- Hotspot (+) -->
          <button
            class="ee-hotspot"
            type="button"
            aria-label="Quick view {{ product.title | escape }}"
            data-open-quick
            data-block-id="{{ block.id }}"
          ></button>

          <!-- Per-block product JSON (used by JS to populate the modal) -->
          <script type="application/json" id="ee-product-json-{{ block.id }}">
            {
              "id": {{ product.id }},
              "title": {{ product.title | json }},
              "handle": {{ product.handle | json }},
              "url": {{ product.url | json }},
              "price": {{ product.price | json }},
              "price_formatted": {{ product.price | money | json }},
              "description": {{ product.description | strip_html | truncate: 220 | json }},
              "images": [{% for img in product.images %}{{ img | image_url: width: 600 | json }}{% unless forloop.last %},{% endunless %}{% endfor %}],
              "options": {{ product.options_with_values | json }},
              "variants": [
                {% for v in product.variants %}
                  {
                    "id": {{ v.id }},
                    "title": {{ v.title | json }},
                    "available": {{ v.available | json }},
                    "price": {{ v.price | json }},
                    "price_formatted": {{ v.price | money | json }},
                    "options": [{% for ov in v.options %}{{ ov | json }}{% unless forloop.last %},{% endunless %}{% endfor %}]
                  }{% unless forloop.last %},{% endunless %}
                {% endfor %}
              ]
            }
          </script>
        </article>
      {% endif %}
    {% endfor %}
  </div>

  <!-- Quick-view Modal (single instance, populated by JS) -->
  <div class="ee-modal" data-modal hidden>
    <div class="ee-modal__backdrop" data-close></div>
    <div class="ee-modal__dialog" role="dialog" aria-modal="true" aria-labelledby="ee-modal-title">
      <button class="ee-modal__close" type="button" aria-label="Close" data-close>×</button>

      <div class="ee-modal__body">
        <div class="ee-modal__media">
          <!-- width/height added for theme-check -->
          <img alt="" width="120" height="120" loading="lazy" decoding="async" data-media>
        </div>

        <div class="ee-modal__info">
          <h3 class="ee-p-name" id="ee-modal-title" data-title></h3>
          <div class="ee-p-price" data-price></div>
          <p class="ee-p-desc" data-desc></p>

          <!-- Color (buttons) -->
          <div class="ee-field" data-color-wrap hidden>
            <label class="ee-field__label">Color</label>
            <div class="ee-color" data-color></div>
          </div>

          <!-- Size (select) -->
          <div class="ee-field" data-size-wrap hidden>
            <label class="ee-field__label">Size</label>
            <div class="ee-size">
              <div class="ee-size__select">
                <select data-size></select>
                <span class="ee-caret"></span>
              </div>
            </div>
          </div>

          <!-- Add to cart -->
          <button class="ee-btn--primary" type="button" data-add>ADD TO CART</button>

          <div class="ee-status" data-status aria-live="polite"></div>
        </div>
      </div>
    </div>
  </div>

  {% schema %}
{
  "name": "EE • Banner+Grid",
  "class": "ee-grid-section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Tisso vison in the wild" },
    { "type": "product", "id": "bonus_product", "label": "Auto-add product (optional)" },
    {
      "type": "text",
      "id": "bonus_rule_color",
      "label": "Auto-add when Color =",
      "default": "Black",
      "info": "Case-insensitive match"
    },
    {
      "type": "text",
      "id": "bonus_rule_size",
      "label": "AND Size =",
      "default": "M",
      "info": "Use label as it appears in options (e.g., M or Medium)"
    }
  ],
  "blocks": [
    { "type": "product", "name": "Product", "settings": [{ "type": "product", "id": "product", "label": "Product" }] }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "EE • Banner+Grid",
      "blocks": [
        { "type": "product" },
        { "type": "product" },
        { "type": "product" },
        { "type": "product" },
        { "type": "product" },
        { "type": "product" }
      ]
    }
  ]
}
  {% endschema %}
</section>
