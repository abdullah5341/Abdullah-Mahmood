{% comment %}
EE • Grid (Custom)
- 3×2 product grid
- Each tile has a hotspot (plus.svg). Clicking opens a Quick-View modal.
- The modal is single-instance and gets populated via JS with the clicked product's info.
{% endcomment %}

<section class="ee-grid" id="ee-grid-{{ section.id }}">
  <div class="ee-grid__wrap">
    {% for block in section.blocks %}
      {% assign product = block.settings.product %}
      {% if product %}
        <article
          class="ee-card"
          data-handle="{{ product.handle }}"
          data-title="{{ product.title | escape }}"
          data-price="{{ product.price | money }}"
          data-desc="{{ product.description | strip_html | truncate: 180 | escape }}"
          data-featured="{{ product.featured_image | image_url: width: 640 }}"
        >
          <a class="ee-card__img" href="{{ product.url }}">
            {{ product.featured_image | image_url: width: 900 | image_tag: alt: product.title }}
          </a>

          <!-- hotspot button (plus.svg) -->
          <button class="ee-hotspot" type="button" aria-label="Quick view {{ product.title }}">
            <img src="{{ 'plus.svg' | asset_url }}" alt="" width="46" height="47" loading="lazy" />
          </button>
        </article>
      {% endif %}
    {% endfor %}
  </div>

  {%- comment -%} Quick-View Modal (single instance) {%- endcomment -%}
  <div class="ee-modal" data-close>
    <div class="ee-modal__backdrop" data-close></div>

    <div class="ee-modal__dialog" role="dialog" aria-modal="true" aria-labelledby="ee-modal-title">
      <button class="ee-modal__close" type="button" aria-label="Close" data-close>×</button>

      <div class="ee-modal__body">
        <div class="ee-modal__media">
          <img class="ee-modal__img" src="" alt="" width="120" height="160" />
        </div>

        <div class="ee-modal__content">
          <h3 id="ee-modal-title" class="ee-name"></h3>
          <div class="ee-price"></div>
          <p class="ee-desc"></p>

          <!-- Color (Component 208/209/210/211 styling) -->
          <div class="ee-field" data-color-wrap hidden>
            <label class="ee-label">Color</label>
            <div class="ee-color">
              <!-- swatches injected by JS (two pills ala figma) -->
            </div>
          </div>

          <!-- Size (Component 213 + 212 dropdown) -->
          <div class="ee-field" data-size-wrap hidden>
            <label class="ee-label">Size</label>
            <div class="ee-size">
              <button class="ee-size__select" type="button" aria-expanded="false">
                <span class="ee-size__text">Choose your size</span>
                <span class="ee-caret">▾</span>
              </button>

              <div class="ee-size__menu">
                <!-- sizes injected by JS (XS–XL etc) -->
              </div>
            </div>
          </div>

          <!-- Add to cart (Component 206/207 button w/ arrow) -->
          <button class="ee-btn--primary ee-qv__add" type="button" data-add disabled>
            ADD TO CART
          </button>
        </div>
      </div>
    </div>
  </div>

  {% schema %}
  {
    "name": "EE • Grid (Custom)",
    "settings": [
      { "type": "text", "id": "heading", "label": "Heading", "default": "Tisso vison in the wild" }
    ],
    "blocks": [
      { "type": "product", "name": "Product", "settings": [
        { "type": "product", "id": "product", "label": "Product" }
      ]}
    ],
    "max_blocks": 6,
    "presets": [{ "name": "EE • Grid (Custom)" }]
  }
  {% endschema %}
</section>
